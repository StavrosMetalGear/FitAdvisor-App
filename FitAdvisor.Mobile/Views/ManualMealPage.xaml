<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:FitAdvisor.Mobile.ViewModels" x:Class="FitAdvisor.Mobile.Views.ManualMealPage" x:DataType="vm:MealsViewModel" Title="Nutrition totals / Σύνολα">
<ScrollView><VerticalStackLayout Padding="20" Spacing="12">
    <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="10">
    <Label Text="Manual food entry / Χειροκίνητη καταχώριση — enter known nutrition totals; this name field does not search foods." FontAttributes="Bold" />
    <Label Text="Local diary date" /><DatePicker Date="{Binding Date}" Format="yyyy-MM-dd" />
    <Button Text="Show meals" Command="{Binding LoadCommand}" />
    <Label Text="Meal or food name" /><Entry Text="{Binding Name}" MaxLength="200" AutomationId="MealName" />
    <Label Text="Quantity" /><Entry Text="{Binding Quantity}" Keyboard="Numeric" />
    <Label Text="Quantity unit (g, ml, serving, etc.)" /><Entry Text="{Binding Unit}" MaxLength="30" />
    <Label Text="Total calories for this quantity (kcal)" /><Entry Text="{Binding Calories}" Keyboard="Numeric" AutomationId="MealCalories" />
    <Label Text="Enter nutrition totals for the entire quantity above, not per 100 g or per serving. Quantity is recorded for context; it does not multiply your entered calories." Style="{StaticResource Caption}" />
    <Label Text="Total protein (g, optional)" /><Entry Text="{Binding Protein}" Keyboard="Numeric" />
    <Label Text="Total carbohydrates (g, optional)" /><Entry Text="{Binding Carbs}" Keyboard="Numeric" />
    <Label Text="Total fat (g, optional)" /><Entry Text="{Binding Fat}" Keyboard="Numeric" />
    </VerticalStackLayout></Border>
    <Button Text="{Binding SaveLabel}" Command="{Binding SaveCommand}" AutomationId="SaveMeal" />
    <Button Style="{StaticResource SecondaryButton}" Text="Clear form" Command="{Binding CancelCommand}" />
<Label Text="{Binding Status}" /></VerticalStackLayout></ScrollView></ContentPage>