<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="FitAdvisor.Mobile.App">
  <Application.Resources><ResourceDictionary>
    <Color x:Key="Accent">#145E50</Color>
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F3F6F5, Dark=#111B18}" /></Style>
    <Style TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light=#182E27, Dark=#E7F2EC}" /><Setter Property="FontSize" Value="16" /></Style>
    <Style TargetType="Entry"><Setter Property="FontSize" Value="16" /><Setter Property="MinimumHeightRequest" Value="52" /><Setter Property="TextColor" Value="{AppThemeBinding Light=#182E27, Dark=#E7F2EC}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#4F625C, Dark=#A0B5AC}" /></Style>
    <Style TargetType="Picker"><Setter Property="FontSize" Value="16" /><Setter Property="MinimumHeightRequest" Value="52" /><Setter Property="TextColor" Value="{AppThemeBinding Light=#182E27, Dark=#E7F2EC}" /></Style>
    <Style TargetType="DatePicker"><Setter Property="FontSize" Value="16" /><Setter Property="MinimumHeightRequest" Value="52" /><Setter Property="TextColor" Value="{AppThemeBinding Light=#182E27, Dark=#E7F2EC}" /></Style>
    <Style TargetType="Button"><Setter Property="LineBreakMode" Value="WordWrap" /><Setter Property="BackgroundColor" Value="{StaticResource Accent}" /><Setter Property="TextColor" Value="White" /><Setter Property="FontSize" Value="16" /><Setter Property="Padding" Value="16,12" /><Setter Property="CornerRadius" Value="14" /><Setter Property="MinimumHeightRequest" Value="52" /></Style>
    <Style x:Key="Heading" TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light=#182E27, Dark=#E7F2EC}" /><Setter Property="FontSize" Value="26" /><Setter Property="FontAttributes" Value="Bold" /></Style>
    <Style x:Key="Caption" TargetType="Label"><Setter Property="FontSize" Value="14" /><Setter Property="TextColor" Value="{AppThemeBinding Light=#52665C, Dark=#B4C8BC}" /></Style>
<Style x:Key="Card" TargetType="Border"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1C2B24}" /><Setter Property="Stroke" Value="{AppThemeBinding Light=#CEDAD3, Dark=#42584B}" /><Setter Property="StrokeShape" Value="RoundRectangle 18" /><Setter Property="Padding" Value="18" /></Style>
<Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="LineBreakMode" Value="WordWrap" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E2ECE6, Dark=#2E4538}" /><Setter Property="TextColor" Value="{AppThemeBinding Light=#145E50, Dark=#EDF5F0}" /><Setter Property="FontSize" Value="16" /><Setter Property="Padding" Value="16,12" /><Setter Property="CornerRadius" Value="14" /><Setter Property="MinimumHeightRequest" Value="52" /></Style>
  <Style TargetType="Editor"><Setter Property="TextColor" Value="{AppThemeBinding Light=#182E27, Dark=#E7F2EC}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#52665C, Dark=#B4C8BC}" /><Setter Property="FontSize" Value="16" /><Setter Property="MinimumHeightRequest" Value="52" /></Style><Style TargetType="Switch"><Setter Property="OnColor" Value="{AppThemeBinding Light=#145E50, Dark=#A7D8BC}" /><Setter Property="ThumbColor" Value="{AppThemeBinding Light=White, Dark=#111B18}" /><Setter Property="MinimumHeightRequest" Value="48" /><Setter Property="MinimumWidthRequest" Value="48" /></Style><Style TargetType="CheckBox"><Setter Property="Color" Value="{AppThemeBinding Light=#145E50, Dark=#A7D8BC}" /><Setter Property="MinimumHeightRequest" Value="48" /><Setter Property="MinimumWidthRequest" Value="48" /></Style></ResourceDictionary></Application.Resources>
</Application>
